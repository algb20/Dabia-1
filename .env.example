# ── Supabase ──────────────────────────────────────────────────────────────
# الـ anon key (عام — يُستخدم من المتصفح)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# الـ service role key (سري — يُستخدم من API routes فقط، لا يُرسل للمتصفح)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Pi Network ────────────────────────────────────────────────────────────
# مفتاح Pi API — من developer portal على Pi Network
PI_API_KEY=your_pi_api_key_here

# ── Push Notifications (VAPID) ────────────────────────────────────────────
# أنشئ مفاتيحك بتشغيل: node -e "const wp=require('web-push');const k=wp.generateVAPIDKeys();console.log(JSON.stringify(k))"
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here

# ── App URL (للإشعارات من الخادم) ──────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://dabiaacdfb2093.pinet.com

# ── Stripe (اختياري) ──────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key_here

# ── Serper (اختياري — للتحقق من الأعمال) ─────────────────────────────────
SERPER_API_KEY=your_serper_api_key_here

# ── Affiliate (موقع Discover) ─────────────────────────────────────────────
# معرّف إحالة أمازون (علني — يظهر في الروابط). القيمة الافتراضية في الكود.
DISCOVER_AMAZON_TAG=dabia08-20
